+int
+mqvpn_bind_posix_path_peek_rx_bytes(const void *vctx, uint64_t *bytes)
+{
+    const bind_path_ctx_t *ctx = (const bind_path_ctx_t *)vctx;
+    if (!ctx || !bytes) return MQVPN_ERR_INVALID_ARG;
+    ssize_t n;
+    do {
