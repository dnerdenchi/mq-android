+static uint64_t
+rate_now_us(void)
+{
+    struct timespec ts;
+    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;
+    return (uint64_t)ts.tv_sec * 1000000ULL + (uint64_t)ts.tv_nsec / 1000ULL;
+}
+
+static uint64_t
+rate_burst(const rate_bucket_t *bucket, uint64_t packet_bytes)
+{
+    uint64_t burst = bucket->bytes_per_second / 10ULL;
+    if (burst < 4096ULL) burst = 4096ULL;
+    return packet_bytes > burst ? packet_bytes : burst;
+}
+
+static void
+rate_refill(rate_bucket_t *bucket, uint64_t packet_bytes)
+{
+    if (bucket->bytes_per_second == 0) return;
+
+    uint64_t now = rate_now_us();
+    uint64_t burst = rate_burst(bucket, packet_bytes);
+    if (bucket->last_refill_us == 0 || now < bucket->last_refill_us) {
+        bucket->tokens = burst;
+        bucket->last_refill_us = now;
+        return;
+    }
+
+    uint64_t elapsed = now - bucket->last_refill_us;
+    uint64_t added;
+    uint64_t remainder = bucket->refill_remainder;
+    if (elapsed > (UINT64_MAX - remainder) / bucket->bytes_per_second) {
+        added = burst;
+        remainder = 0;
+    } else {
+        uint64_t accrued = elapsed * bucket->bytes_per_second + remainder;
+        added = accrued / 1000000ULL;
+        remainder = accrued % 1000000ULL;
+    }
+    uint64_t tokens = bucket->tokens < burst ? bucket->tokens : burst;
+    uint64_t room = burst - tokens;
+    if (added >= room) {
+        bucket->tokens = burst;
+        bucket->refill_remainder = 0;
+    } else {
+        bucket->tokens = tokens + added;
+        bucket->refill_remainder = remainder;
+    }
+    bucket->last_refill_us = now;
+}
+
+static uint64_t
+rate_wait_us(uint64_t bytes, uint64_t rate, uint64_t remainder)
+{
+    if (rate == 0) return UINT64_MAX;
+    if (bytes > UINT64_MAX / 1000000ULL) return UINT64_MAX;
+    uint64_t numerator = bytes * 1000000ULL;
+    if (numerator > remainder) numerator -= remainder;
+    else return 0;
+    uint64_t wait = numerator / rate;
+    return numerator % rate == 0 || wait == UINT64_MAX ? wait : wait + 1;
+}
+
+static int
+rate_can_take(rate_bucket_t *bucket, uint64_t bytes, uint64_t *wait_us)
+{
+    if (wait_us) *wait_us = 0;
+    if (bucket->bytes_per_second == 0 || bytes == 0) return 1;
+
+    rate_refill(bucket, bytes);
+    if (bucket->tokens >= bytes) return 1;
+    if (wait_us)
+        *wait_us = rate_wait_us(bytes - bucket->tokens, bucket->bytes_per_second,
+                                bucket->refill_remainder);
+    return 0;
+}
+
+static int
+rate_take(rate_bucket_t *bucket, uint64_t bytes)
+{
+    if (!rate_can_take(bucket, bytes, NULL)) return 0;
+    if (bucket->bytes_per_second != 0) bucket->tokens -= bytes;
+    return 1;
+}
+
+static void
+rate_set(rate_bucket_t *bucket, uint64_t bytes_per_second)
+{
+    if (bucket->bytes_per_second == bytes_per_second) return;
+    bucket->bytes_per_second = bytes_per_second;
+    bucket->tokens = bytes_per_second == 0 ? 0 : rate_burst(bucket, 0);
+    bucket->last_refill_us = rate_now_us();
+    bucket->refill_remainder = 0;
+}
+
+static unsigned
+path_rate_allowed_prefix(rate_bucket_t *bucket, const mqvpn_datagram_t *bufs,
+                         unsigned count)
+{
+    if (bucket->bytes_per_second == 0 || count == 0) return count;
+
+    rate_refill(bucket, bufs[0].len);
+    uint64_t used = 0;
+    unsigned allowed = 0;
+    while (allowed < count) {
+        uint64_t packet_bytes = (uint64_t)bufs[allowed].len;
+        if (UINT64_MAX - used < packet_bytes || used + packet_bytes > bucket->tokens) break;
+        used += packet_bytes;
+        allowed++;
+    }
+    return allowed;
+}
+
+static uint64_t
+path_rate_prefix_bytes(const mqvpn_datagram_t *bufs, unsigned count)
+{
+    uint64_t bytes = 0;
+    for (unsigned i = 0; i < count; i++) {
+        uint64_t packet_bytes = (uint64_t)bufs[i].len;
+        if (UINT64_MAX - bytes < packet_bytes) return UINT64_MAX;
+        bytes += packet_bytes;
+    }
+    return bytes;
+}
